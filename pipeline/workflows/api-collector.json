      "parameters": {
        "jsCode": "const keywordMap = {\n  정치: [\n    '대통령', '국회', '여당', '야당', '선거', '정당', '국무총리',\n    '외교', '국방', '헌법', '탄핵', '공천', '법안', '의원', '입법'\n  ],\n  경제: [\n    '주식', '부동산', '금리', '물가', '환율', '코스피',\n    '수출', '무역', '기업', '취업', '실업', '한국은행', '재정', '세금'\n  ],\n  사회: [\n    '사건사고', '범죄', '재난', '교육', '복지', '의료', '저출생',\n    '청년', '주거', '환경', '노동', '인권', '이민', '사회갈등'\n  ]\n};\n\nconst categoryIdMap = { 정치: 1, 경제: 2, 사회: 3 };\nconst pages = [1, 101, 201, 301, 401];\n\nconst combinations = [];\nfor (const [category, keywords] of Object.entries(keywordMap)) {\n  for (const keyword of keywords) {\n    for (const start of pages) {\n      combinations.push({ json: { keyword, start, category_id: categoryIdMap[category] } });\n    }\n  }\n}\nreturn combinations;"
      },
