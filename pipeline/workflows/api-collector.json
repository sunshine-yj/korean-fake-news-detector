      "parameters": {
        "jsCode": "const meta = $('1개씩 처리1').item.json;\n\nconst skipTitles = ['전보','인사발령','부고','빈소','발인','조모상','조부상','부친상','모친상','별세','과장급','국장급','팀장급','차관급','장관급','승진','임명','위촉','영전'];\nif (skipTitles.some(k => (meta.title||'').includes(k))) {\n  return [{ json: { ...meta, content: '', _skip: true } }];\n}\n\nconst html = $input.first().json.data || '';\n\n// articleInnerTextContent 필드 추출\nconst match = html.match(/\"articleInnerTextContent\":\"([\\s\\S]*?)(?:\",\"articleSummary|\",\"articleLike)/);\nif (!match) {\n  return [{ json: { ...meta, content: '', _skip: true } }];\n}\n\nconst content = match[1]\n  .replace(/\\\\n/g, ' ')\n  .replace(/\\\\\"/g, '\"')\n  .replace(/\\[[^\\]]{0,100}\\]/g, '')\n  .replace(/[가-힣]+\\s*기자\\s+[\\w.]+@[\\w.]+/g, '')\n  .replace(/\\([가-힣\\s]+\\s*:\\s*[가-힣]+\\)/g, '')\n  .replace(/[가-힣]+\\s*기자$/g, '')\n  .replace(/[\\w.]+@[\\w.]+\\.[a-z]+/g, '')\n  .replace(/ⓒ.*?금지/g, '')\n  .replace(/\\s+/g, ' ')\n  .trim();\n\nif (!content || content.length < 100) {\n  return [{ json: { ...meta, content: '', _skip: true } }];\n}\n\nreturn [{ json: { ...meta, content, _skip: false } }];"
