    {
      "parameters": {
        "jsCode": "const apiItems = $input.first().json.items || [];\nconst { keyword, category_id } = $('1개씩 처리').item.json;  // category_id 추가\n\nconst allowedDomains = ['yna.co.kr', 'sbs.co.kr', 'donga.com', 'hani.co.kr', 'jtbc.co.kr'];\nconst skipTitles = ['전보','인사발령','부고','빈소','발인','조모상','조부상','부친상','모친상','별세','과장급','국장급','팀장급','차관급','장관급','승진','임명','위촉','영전'];\n\nconst parseDate = (str) => {\n  if (!str) return new Date().toISOString().slice(0,19).replace('T',' ');\n  const d = new Date(str);\n  return !isNaN(d.getTime()) ? d.toISOString().slice(0,19).replace('T',' ') : new Date().toISOString().slice(0,19).replace('T',' ');\n};\n\nconst stripHtml = (str) =>\n  (str || '').replace(/<[^>]+>/g, '').replace(/&quot;/g,'\"').replace(/&amp;/g,'&').replace(/&lt;/g,'<').replace(/&gt;/g,'>').replace(/&#\\d+;/g,'').trim();\n\nconst sourceMap = {\n  'yna.co.kr':  1,\n  'sbs.co.kr':  6,\n  'donga.com':  7,\n  'hani.co.kr': 8,\n  'jtbc.co.kr': 10\n};\n\nreturn apiItems\n  .filter(item => {\n    const url = item.originallink || item.link || '';\n    const title = item.title || '';\n    return allowedDomains.some(d => url.includes(d)) && !skipTitles.some(k => title.includes(k));\n  })\n  .map(item => {\n    const url = item.originallink || item.link || '';\n    const domain = allowedDomains.find(d => url.includes(d)) || '';\n    return {\n      json: {\n        title:        stripHtml(item.title),\n        url,\n        published_at: parseDate(item.pubDate),\n        is_fake:      0,\n        source_id:    sourceMap[domain] || 1,\n        category_id   // 키워드 카테고리에서 자동 매핑\n      }\n    };\n  });"
      },
