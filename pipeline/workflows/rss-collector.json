    {
      "parameters": {
        "jsCode": "// 3개 RSS XML에서 <item> 블록만 추출해서 하나로 합치기\nconst allItemsXml = $input.all()\n  .map(input => input.json.data || '')\n  .map(xml => {\n    const matches = xml.match(/<item>[\\s\\S]*?<\\/item>/g) || [];\n    return matches.join('\\n');\n  })\n  .join('\\n');\n\n// 단일 RSS XML로 재조합\nconst combined = `<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<rss version=\"2.0\">\n  <channel>\n    <title>합쳐진 RSS</title>\n    ${allItemsXml}\n  </channel>\n</rss>`;\n\nreturn [{ json: { data: combined } }];"
