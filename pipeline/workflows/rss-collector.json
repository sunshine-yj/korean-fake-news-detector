    {
      "parameters": {
        "jsCode": "const raw = $input.first().json;\nlet feed = raw.data ? (Array.isArray(raw.data) ? raw.data[0] : raw.data) : raw;\nconst rawItems = feed?.rss?.channel?.item || [];\nconst items = Array.isArray(rawItems) ? rawItems : [rawItems];\n\nconst parseDate = (str) => {\n  if (!str) return new Date().toISOString().slice(0,19).replace('T',' ');\n  const d = new Date(str);\n  return !isNaN(d.getTime()) ? d.toISOString().slice(0,19).replace('T',' ') : new Date().toISOString().slice(0,19).replace('T',' ');\n};\n\nconst skipTitles = ['전보','인사발령','부고','빈소','발인','조모상','조부상','부친상','모친상','별세','과장급','국장급','팀장급','차관급','장관급','승진','임명','위촉','영전'];\n\nreturn items\n  .filter(item => !skipTitles.some(k => (item.title||'').includes(k)))\n  .map(item => {\n    const title = Array.isArray(item.title) ? item.title[0] : (item.title || '');\n    const url   = Array.isArray(item.link)  ? item.link[0]  : (item.link  || '');\n    return { json: {\n      title:        title.trim(),\n      url,\n      published_at: parseDate(item.pubDate),\n      is_fake:      0,\n      source_id:    11,\n      category_id:  3\n    }};\n  });"
      },
