    {
      "parameters": {
        "jsCode": "const meta = $('1개씩 처리1').item.json;\nconst skipTitles = ['전보','인사발령','부고','빈소','발인','조모상','조부상','부친상','모친상','별세','과장급','국장급','팀장급','차관급','장관급','승진','임명','위촉','영전'];\nif (skipTitles.some(k => (meta.title||'').includes(k))) {\n  return [{ json: { ...meta, content: '', _skip: true } }];\n}\nconst c = $input.first().json.content;\nconst items = Array.isArray(c) ? c : [c || ''];\nconst content = items\n  .map(t => (t||'')\n    .replace(/\\[[^\\]]{0,100}\\]/g, '')\n    .replace(/\\([가-힣]+=[가-힣]+\\)\\s*/g, '')\n    .replace(/[가-힣]+\\s*기자\\s+[\\w.]+@[\\w.]+/g, '')\n    .replace(/[가-힣]+\\s*기자\\s*=\\s*/g, '')\n    .replace(/[가-힣]+\\s*기자$/g, '')\n    .replace(/[\\w.]+@[\\w.]+\\.[a-z]+/g, '')\n    .replace(/\\s+/g, ' ').trim()\n  )\n  .filter(t => {\n    if (t.length < 15) return false;\n    if (t.includes('◇')) return false;\n    if (t.includes('▲')) return false;\n    if (t.includes('저작권자')) return false;\n    if (t.includes('카카오톡')) return false;\n    if (t.includes('무단 전재')) return false;\n    if (t.includes('자료사진')) return false;\n    if (t.includes('송고')) return false;\n    return true;\n  })\n  .join(' ').trim();\nif (!content || content.length < 100) {\n  return [{ json: { ...meta, content: '', _skip: true } }];\n}\nreturn [{ json: { ...meta, content, _skip: false } }];"
      },
