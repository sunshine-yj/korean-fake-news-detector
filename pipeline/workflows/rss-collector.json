    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nif (item._skip === true) {\n  return [{ json: { ...item, _skip: true } }];\n}\nconst content = item.content || '';\nif (content.length < 100) {\n  return [{ json: { ...item, _skip: true } }];\n}\n// TEXT 최대 65535 bytes, 한글 3bytes이므로 21845자 제한\nif (content.length > 21000) {\n  return [{ json: { ...item, content: content.slice(0, 21000), _skip: false } }];\n}\nreturn [{ json: { ...item, _skip: false } }];"
