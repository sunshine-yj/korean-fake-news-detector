      ],
      "id": "0562d699-7e4b-4c64-b7a4-cd3d6bf507b5",
      "name": "② 가짜 제목 생성 LLM1",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 30000,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const original =\n  String($('역할 부여 프롬프트1')\n    .item.json.content || '');\n\nconst generated =\n  String($('① 가짜 본문 생성 LLM1')\n    .item.json.text || '');\n\nconst promptType =\n  $('역할 부여 프롬프트1')\n    .item.json.prompt_type;\n\nconst refusedKeywords = [\n  '도와드릴 수 없',\n  '죄송합니다',\n  '악용될 위험',\n  '정책상'\n];\n\nconst isRefused =\n  refusedKeywords.some(k =>\n    generated.includes(k)\n  );\n\nconst isSame =\n  original.trim() === generated.trim();\n\nconst validLength =\n  generated.length > original.length * 0.6;\n\nlet typeValid = true;\n\nif (promptType === 1) {\n\n  const origNums =\n    original.match(/\\d+/g) || [];\n\n  const genNums =\n    generated.match(/\\d+/g) || [];\n\n  typeValid =\n    JSON.stringify(origNums)\n    !==\n    JSON.stringify(genNums);\n}\n\nconst isValid =\n  !isRefused\n  &&\n  !isSame\n  &&\n  validLength\n  &&\n  typeValid;\n\nreturn {\n  json: {\n    ...$input.item.json,\n    generatedContent: generated,\n    isValid\n  }\n};"
      },
