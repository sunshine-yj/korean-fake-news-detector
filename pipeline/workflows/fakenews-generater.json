      "id": "f2cc0590-fbad-4d17-8d6d-46d2fef38f96",
      "name": "기사 프롬프트 균형 조절1",
      "credentials": {
        "mySql": {
          "id": "OpysWOKeooCF6vzL",
          "name": "MySQL account"
        }
